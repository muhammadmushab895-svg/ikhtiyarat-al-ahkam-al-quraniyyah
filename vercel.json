{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/turath/page",
      "destination": "https://api.turath.io/page"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        }
      ]
    }
  ]
}
